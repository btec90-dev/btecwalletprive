{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "User financial account (Cash, Bank, Tap Tap Send, MoneyGram, or private TWT [Year])",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique account ID" },
        "name": { "type": "string", "description": "Account name" },
        "type": { "type": "string", "description": "Account type: CASH, CARD, SAVINGS, CUSTOM" },
        "balance": { "type": "number", "description": "Current balance" },
        "currencyCode": { "type": "string", "description": "Currency code: CFA or USD" },
        "emojiAvatar": { "type": "string", "description": "Emoji icon" },
        "sortOrder": { "type": "number", "description": "Display order" },
        "isTwt": { "type": "boolean", "description": "Whether account belongs to private admin TWT" },
        "updatedBy": { "type": "string", "description": "UID of updater" },
        "clientUpdatedAt": { "type": "number", "description": "Client update epoch ms" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["id", "name", "type", "balance", "currencyCode", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction ID" },
        "accountId": { "type": "string", "description": "Associated account ID" },
        "type": { "type": "string", "description": "EXPENSE or INCOME" },
        "amount": { "type": "number", "description": "Positive transaction amount" },
        "payee": { "type": "string", "description": "Payee or recipient name" },
        "category": { "type": "string", "description": "Transaction category" },
        "timestamp": { "type": "number", "description": "Transaction epoch timestamp ms" },
        "notes": { "type": "string", "description": "Optional memo" },
        "currencyCode": { "type": "string", "description": "Currency code: CFA or USD" },
        "isTwt": { "type": "boolean", "description": "Whether transaction belongs to private TWT" },
        "updatedBy": { "type": "string", "description": "UID of updater" },
        "clientUpdatedAt": { "type": "number", "description": "Client update epoch ms" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["id", "accountId", "type", "amount", "payee", "category", "timestamp", "currencyCode", "updatedAt"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Scheduled recurring ledger transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique recurring ID" },
        "accountId": { "type": "string", "description": "Associated account ID" },
        "type": { "type": "string", "description": "EXPENSE or INCOME" },
        "amount": { "type": "number", "description": "Positive recurring amount" },
        "payee": { "type": "string", "description": "Payee name" },
        "category": { "type": "string", "description": "Category" },
        "currencyCode": { "type": "string", "description": "Currency code: CFA or USD" },
        "frequency": { "type": "string", "description": "DAILY, WEEKLY, MONTHLY, or YEARLY" },
        "startDate": { "type": "number", "description": "Start timestamp ms" },
        "lastExecutedDate": { "type": "number", "description": "Last execution timestamp ms" },
        "nextDueDate": { "type": "number", "description": "Next due timestamp ms" },
        "isActive": { "type": "boolean", "description": "Whether schedule is active" },
        "notes": { "type": "string", "description": "Optional notes" },
        "updatedBy": { "type": "string", "description": "UID of updater" },
        "clientUpdatedAt": { "type": "number", "description": "Client update epoch ms" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["id", "accountId", "type", "amount", "payee", "category", "currencyCode", "frequency", "nextDueDate", "isActive", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Custom shared category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Sanitized category document ID" },
        "name": { "type": "string", "description": "Display category name" },
        "icon": { "type": "string", "description": "Category emoji icon" },
        "updatedBy": { "type": "string", "description": "UID of updater" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["id", "name", "icon", "updatedAt"]
    }
  },
  "firestore": {
    "/shared_wallets/{walletId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "Shared non-TWT accounts synced between 410bala@gmail.com and traore200@gmail.com"
    },
    "/shared_wallets/{walletId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Shared non-TWT ledger transactions"
    },
    "/shared_wallets/{walletId}/recurring/{recurringId}": {
      "schema": "RecurringTransaction",
      "description": "Shared non-TWT recurring transaction schedules"
    },
    "/shared_wallets/{walletId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Shared custom categories"
    },
    "/private_twt/{ownerKey}/accounts/{accountId}": {
      "schema": "Account",
      "description": "Private TWT [Year] account strictly restricted to primary admin (410bala@gmail.com)"
    },
    "/private_twt/{ownerKey}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Private TWT [Year] transactions strictly restricted to primary admin"
    },
    "/private_twt/{ownerKey}/recurring/{recurringId}": {
      "schema": "RecurringTransaction",
      "description": "Private TWT recurring schedules strictly restricted to primary admin"
    }
  }
}
